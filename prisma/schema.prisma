// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== AUTH ====================
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String
  image         String?
  role          UserRole  @default(PLAYER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  characters    Character[]
  campaigns     Campaign[]
  accounts      Account[]
  sessions      Session[]
}

enum UserRole {
  ADMIN
  DUNGEON_MASTER
  PLAYER
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==================== MUTATIONS ====================
model Mutation {
  id          String    @id @default(cuid())
  name        String    @unique
  description String    @db.Text
  category    String    // Telekinesis, Telepathy, Enhanced Strength, etc.
  type        String    // Offensive, Defensive, Utility
  image       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  levels      MutationLevel[]
  characters  Character[]
}

model MutationLevel {
  id          String    @id @default(cuid())
  mutationId  String
  level       Int       // 1-10
  name        String    // Level 1, Level 2, etc.
  description String    @db.Text
  effects     String    @db.Text // JSON with effects
  powerCost   Int       // Energy/Power cost
  cooldown    Int?      // In seconds
  createdAt   DateTime  @default(now())

  mutation    Mutation  @relation(fields: [mutationId], references: [id], onDelete: Cascade)

  @@unique([mutationId, level])
}

// ==================== CHARACTERS ====================
model Character {
  id          String    @id @default(cuid())
  userId      String
  name        String
  description String?   @db.Text
  image       String?
  level       Int       @default(1)
  experience  Int       @default(0)
  health      Int       @default(100)
  maxHealth   Int       @default(100)
  power       Int       @default(100)
  maxPower    Int       @default(100)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mutations   CharacterMutation[]
  campigns    CampaignCharacter[]
}

model CharacterMutation {
  id          String    @id @default(cuid())
  characterId String
  mutationId  String
  currentLevel Int     @default(1)

  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  mutation    Mutation  @relation(fields: [mutationId], references: [id], onDelete: Cascade)

  @@unique([characterId, mutationId])
}

// ==================== CAMPAIGNS ====================
model Campaign {
  id          String    @id @default(cuid())
  userId      String    // Dungeon Master
  name        String
  description String?   @db.Text
  image       String?
  status      CampaignStatus @default(ACTIVE)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  characters  CampaignCharacter[]
  missions    Mission[]
}

enum CampaignStatus {
  ACTIVE
  PAUSED
  COMPLETED
  DRAFT
}

model CampaignCharacter {
  id          String    @id @default(cuid())
  campaignId  String
  characterId String
  joinedAt    DateTime  @default(now())

  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([campaignId, characterId])
}

model Mission {
  id          String    @id @default(cuid())
  campaignId  String
  title       String
  description String    @db.Text
  objectives  String    @db.Text // JSON array
  status      MissionStatus @default(ACTIVE)
  difficulty  String    // Easy, Medium, Hard, Extreme
  rewards     String?   @db.Text // JSON
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

enum MissionStatus {
  ACTIVE
  COMPLETED
  FAILED
  ARCHIVED
}

// ==================== LORE ====================
model LoreEntry {
  id          String    @id @default(cuid())
  title       String
  content     String    @db.Text
  category    String    // History, Institute, Characters, World
  image       String?
  order       Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model MainCharacter {
  id          String    @id @default(cuid())
  name        String    @unique
  title       String
  description String    @db.Text
  image       String
  mutations   String    @db.Text // JSON array
  role        String    // Professor, Student, Staff, etc.
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
